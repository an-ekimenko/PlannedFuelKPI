<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Путь к папке с логами приложения -->
        <Property name="LOG_DIR">logs</Property>
    </Properties>

    <Appenders>
        <!-- 1. Аппендер для вывода в консоль -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- 2. Аппендер для записи в файл (перезаписывается при каждом запуске или дописывается) -->
        <File name="FileAppender" fileName="${LOG_DIR}/application.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- Корневой логгер, который направляет потоки логов во все связанные аппендеры -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileAppender"/>
        </Root>
    </Loggers>
</Configuration>
